# Copie este arquivo para .env e substitua todos os valores CHANGE_ME.
# Nunca versione o arquivo .env real.

TZ=America/Sao_Paulo

PYTHON_VERSION=3.12
NODE_MAJOR=22
GRAPHIFYY_VERSION=0.9.32

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=nfx_inov
POSTGRES_USER=nfx_inov
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_HOST_PORT=5433

MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MINIO_ROOT_USER=nfx_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
MINIO_BUCKET=nfx-documentos
MINIO_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011

# Linux: obtenha com `stat -c '%g' /var/run/docker.sock`.
DOCKER_SOCKET_GID=0
