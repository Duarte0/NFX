# Copie este arquivo para .env e substitua todos os valores CHANGE_ME.
# Nunca versione o arquivo .env real.

# Perfil obrigatório e secreto de Django. Segredos podem vir de variável ou de um
# arquivo montado apontado por NFX_SECRET_KEY_FILE; nunca preencha ambos.
NFX_PROFILE=development
NFX_SECRET_KEY=CHANGE_ME_SET_OUTSIDE_VERSION_CONTROL
# NFX_SECRET_KEY_FILE=/run/secrets/nfx_secret_key

# Chave mestre externa para certificados: base64url de exatamente 32 bytes.
NFX_CERTIFICATE_MASTER_KEY=CHANGE_ME_BASE64URL_32_BYTE_KEY
# NFX_CERTIFICATE_MASTER_KEY_FILE=/run/secrets/nfx_certificate_master_key

# Same-host backup directory. Keep it outside the repository and protect it separately.
NFX_BACKUP_DIR=/var/backups/nfx

# P0 só disponibiliza o simulador vazio; destinos fiscais reais não existem aqui.
NFX_FISCAL_TRANSPORT=simulator
NFX_FISCAL_DESTINATION=simulator://empty
NFX_FISCAL_ALLOWLIST=simulator://empty

TZ=America/Sao_Paulo

PYTHON_VERSION=3.12
NODE_MAJOR=22
GRAPHIFYY_VERSION=0.9.32

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=nfx_inov
POSTGRES_USER=nfx_inov
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/${POSTGRES_DB}

MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MINIO_ROOT_USER=nfx_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
MINIO_BUCKET=nfx-documentos
MINIO_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
MINIO_ENDPOINT=http://127.0.0.1:${MINIO_HOST_PORT}

# Linux: obtenha com `stat -c '%g' /var/run/docker.sock`.
DOCKER_SOCKET_GID=0
